{
  "name": "erp-suite",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix mobile",
    "dev": "docker compose up --build",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mobile": "npm run start --prefix mobile",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "typecheck:mobile": "npm run typecheck --prefix mobile",
    "test": "npm run test --prefix backend -- --runInBand",
    "seed": "npm run seed --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "migrate:deploy": "npm run prisma:migrate:deploy --prefix backend",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:agent-wms": "node scripts/smoke-agent-wms-flow.mjs",
    "smoke:mobile-agent-picker": "node scripts/smoke-mobile-agent-picker-flow.mjs",
    "smoke:pos-wms": "node scripts/smoke-pos-wms-flow.mjs",
    "smoke:pos-no-wms": "node scripts/smoke-pos-bypass-wms-flow.mjs",
    "smoke:full": "node scripts/smoke-suite.mjs"
  }
}
